{
  "hooks": {
    "SessionStart": [{
      "matcher": "startup|resume|clear|compact",
      "hooks": [{
        "type": "command",
        "command": "python3 \"$PLUGIN_ROOT/hooks/context.py\"",
        "commandWindows": "python \"$env:PLUGIN_ROOT/hooks/context.py\"",
        "timeout": 10,
        "statusMessage": "Reading project rule pointers"
      }]
    }],
    "UserPromptSubmit": [{
      "hooks": [{
        "type": "command",
        "command": "python3 \"$PLUGIN_ROOT/hooks/context.py\"",
        "commandWindows": "python \"$env:PLUGIN_ROOT/hooks/context.py\"",
        "timeout": 10,
        "statusMessage": "Checking project context entry"
      }]
    }]
  }
}
